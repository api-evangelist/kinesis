{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/CreateApplicationPresignedUrlRequest",
  "title": "CreateApplicationPresignedUrlRequest",
  "type": "object",
  "required": [
    "ApplicationName",
    "UrlType"
  ],
  "properties": {
    "ApplicationName": {
      "allOf": [
        {
          "$ref": "#/components/schemas/ApplicationName"
        },
        {
          "description": "The name of the application."
        }
      ]
    },
    "UrlType": {
      "allOf": [
        {
          "$ref": "#/components/schemas/UrlType"
        },
        {
          "description": "The type of the extension for which to create and return a URL. Currently, the only valid extension URL type is <code>FLINK_DASHBOARD_URL</code>. "
        }
      ]
    },
    "SessionExpirationDurationInSeconds": {
      "allOf": [
        {
          "$ref": "#/components/schemas/SessionExpirationDurationInSeconds"
        },
        {
          "description": "The duration in seconds for which the returned URL will be valid."
        }
      ]
    }
  }
}